# PulseGuard Environment Configuration

# Service Ports
GATEWAY_PORT=3000
COLLECTOR_PORT=8080
ANALYZER_PORT=5000

# Analyzer Settings
ALERT_THRESHOLD=90.0

# Logging
LOG_LEVEL=INFO

# Service URLs (used by gateway to reach other services)
COLLECTOR_URL=http://localhost:8080
ANALYZER_URL=http://localhost:5000
